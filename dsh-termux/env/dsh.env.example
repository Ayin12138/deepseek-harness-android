# DeepSeek Harness · 环境变量模板
# 复制到 $DSH_HOME/.env（默认 ~/.dsh/.env），作为「只读回退层」。
# 注意：DEEPSEEK_API_KEY 建议用 configure.sh 写入 ~/.dsh/.credentials.yaml
# （DSH 自管理密钥库，优先级高于本 .env）。本文件只放非敏感/回退项。

# DeepSeek 官方 API 端点（可指向内网网关/代理）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Web 端口（start.sh 读取；DSH 默认 3080）
DSH_PORT=3080

# 可选：自定义配置根目录（默认 ~/.dsh）
# DSH_HOME=~/dsh-data
